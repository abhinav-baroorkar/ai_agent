# Copy to .env (git-ignored) and fill in.

# Ollama server (default local install)
OLLAMA_HOST=http://localhost:11434

# Home Assistant: Profile -> Security -> Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Optional: override config selections
# SASHA_PROFILE=pc
# SASHA_ASSISTANT_CONFIG=/path/to/assistant.yaml
